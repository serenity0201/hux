          if not ok or not controlled then return false end
        end
      end
    end
    return next(checked)~=nil
  end

  local function dragToPad(box,counter)
    local part=box.PrimaryPart
    assert(part and not part.Anchored,"Shop box cannot be dragged")
    local bound,size=box:GetBoundingBox()
    local pivot=box:GetPivot()
    local desired=counter.CFrame*CFrame.new(0,counter.Size.Y/2+size.Y/2-.08,0)
    local target=desired*bound:ToObjectSpace(pivot)
    if CodexItemTP.eligible(box) then
      local ok,why=CodexItemTP.move(box,target,function() return stopped or not statusGui.Parent or not box.Parent end)
      assert(ok,why or "Could not move the shop box")
      return desired
    end
    for attempt=1,3 do
      assert(box.Parent and part.Parent,"Shop box disappeared while moving to checkout")
      pcall(function() box:PivotTo(target) end)
      part.AssemblyLinearVelocity=Vector3.zero
      part.AssemblyAngularVelocity=Vector3.zero
      task.wait(.1)
      local current=box:GetBoundingBox()
      if (current.Position-desired.Position).Magnitude<.8 then
        task.wait(.1)
        current=box:GetBoundingBox()
        if (current.Position-desired.Position).Magnitude<.8 then return desired end
      end
      if hasBoxControl(box)~=true then dragging:FireServer(box) end
      task.wait(.1)
    end
    error("Could not keep the shop box on the checkout counter")
  end
  local function moveBoughtToPlot(box)
    local part=box.PrimaryPart or box:FindFirstChildWhichIsA("BasePart",true)
    if not part then return false end
    status("Bringing purchased box back to the plot...")
    local bound,size=box:GetBoundingBox()
    local desired=CFrame.new(hit+Vector3.new(0,size.Y/2+.15,0))
    local target=desired*bound:ToObjectSpace(box:GetPivot())
    if CodexItemTP.eligible(box) then
      return CodexItemTP.move(box,target,function() return stopped or not statusGui.Parent or not box.Parent end)
    end
    local control=hasBoxControl(box)
    for attempt=1,3 do
      if not box.Parent then return false end
      if control==false or attempt>1 and control~=true then
        status("Reclaiming purchased box for the plot move...")
        __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=CFrame.new(part.Position+Vector3.new(0,2,3))
        task.wait(.1)
        dragging:FireServer(box)
        if requestOwnership then requestOwnership:FireServer(part.AssemblyRootPart or part) end
        task.wait(.1)
        control=hasBoxControl(box)
      end
      pcall(function() box:PivotTo(target) end)
      part.AssemblyLinearVelocity=Vector3.zero
      part.AssemblyAngularVelocity=Vector3.zero
      task.wait(.1)
      local current=box:GetBoundingBox()
      if (current.Position-desired.Position).Magnitude<1 then
        __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=CFrame.new(hit+Vector3.new(0,3,3))
        if hasBoxControl(box)==false then dragging:FireServer(box) end
        return true
      end
      control=false
    end
    return false
  end
  local function prepareBoughtForPlacement(box,id)
    local remaining=nextPlacementAt-os.clock()
    if remaining>0 then
      status("Placement cooldown "..string.format("%.2f",remaining).."s; moving "..id.." to the base...")
      if not moveBoughtToPlot(box) then
        warn("Wire Atelier bought "..id.." but could not move its box to the plot; trying placement with the purchased box")
      end
    else
      status("Purchase confirmed: "..id.."; placing directly from the purchased box...")
    end
  end
  local function buyOne(id)
    local price=infoRoot[id].Price.Value
    assert(player.leaderstats.Money.Value>=price,"Need "..price.." cash to buy one "..id.." box")
    local box=nil
    for attempt=1,360 do
      box=stockBox(id)
      if box then break end
      if attempt%40==0 then status("Waiting for "..id.." to restock ("..math.floor(attempt/4).."s)...") end
      task.wait(.25)
    end
    assert(box,"No shop stock for "..id.." after 90 seconds; check stock or choose another color")
    local part=box.PrimaryPart
    status("Going to the "..id.." stock box...")
    __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=CFrame.new(box.PrimaryPart.Position+Vector3.new(0,2,3))
    task.wait(.1)
    local counter,npc,head=shopFor(box)
    if hasBoxControl(box)==false then dragging:FireServer(box);task.wait(.1) end
    for attempt=1,30 do
      if boxOwner(box) and boxOwner(box).Value==player then break end
      if attempt%4==0 then
        if requestOwnership then requestOwnership:FireServer(part.AssemblyRootPart or part) end
        dragging:FireServer(box)
      end
      task.wait(.1)
    end
    assert(boxOwner(box) and boxOwner(box).Value==player,"Could not take ownership of store box "..id)
    status("Dragging "..id.." to the buy pad...")
    local destination=dragToPad(box,counter)
    __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=CFrame.new(counter.Position+Vector3.new(0,2,3))
    task.wait(.1)
    if hasBoxControl(box)~=true then dragging:FireServer(box);task.wait(.1) end
    local before={}
    for _,model in ipairs(workspace.PlayerModels:GetChildren()) do before[model]=true end
    local npcInfo=nil
    pcall(function() invokeBounded(chattingValue,1.5,0) end)
    local connection=promptChat.OnClientEvent:Connect(function(active,info)
      if active and info and info.Character==npc and info.ID then npcInfo=info end
    end)
    __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=CFrame.new(head.Position+Vector3.new(0,0,3))
    task.wait(.1)
    for attempt=1,3 do
      if npcInfo then break end
      promptChat:FireServer(true,npc)
      for tick=1,20 do if npcInfo then break end;task.wait(.05) end
    end
    connection:Disconnect()
    assert(npcInfo,"Cashier prompt did not arrive for "..id.."; store may be closed")
    local moneyBefore=player.leaderstats.Money.Value
    status("Buying "..id.." at the cashier...")
    pcall(function() invokeBounded(chattingValue,1.5,1) end)
    task.wait(.1)
    local purchaseOk,purchaseError=pcall(function()
      local first,tries=nil,0
      while tries<4 do
        tries=tries+1
        first=invokeBounded(chatting,8,npcInfo,"Initiate")
        if first then break end
        status("Waiting for cashier to see "..id.." on the counter ("..tries..")...")
        if tries%2==0 then
          local control=hasBoxControl(box)
          if control~=true then
            assert(box.PrimaryPart,"Stock box disappeared before checkout")
            __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=CFrame.new(box.PrimaryPart.Position+Vector3.new(0,2,3))
            task.wait(.1)
            dragging:FireServer(box)
            if requestOwnership then requestOwnership:FireServer(box.PrimaryPart.AssemblyRootPart or box.PrimaryPart) end
            task.wait(.1)
          end
          destination=dragToPad(box,counter)
          __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=CFrame.new(head.Position+Vector3.new(0,0,3))
          task.wait(.1)
        else
          task.wait(math.min(.12+tries*.04,.3))
        end
      end
      local region=counter.CFrame*CFrame.new(0,counter.Size.Y/2+.3,0)
      local selected=false
      local parts=workspace:GetPartBoundsInBox(region,Vector3.new(counter.Size.X,.6,counter.Size.Z))
      for _,piece in ipairs(parts) do
        if piece:IsDescendantOf(box) then
          selected=true
        else
          local other=piece.Parent
          if other and other:IsA("Model") and other~=box and boxOwner(other) and boxItem(other,false) then
            error("Another shop box is on the cashier counter; stopped before confirming a purchase")
          end
        end
      end
      assert(selected and boxOwner(box) and boxOwner(box).Value==player,"Selected "..id.." box is not safely on the cashier counter")
      if not first then status("Cashier response was empty; checking the selected box once...") end
      task.wait(.05)
      local current=box:GetBoundingBox()
      assert((current.Position-destination.Position).Magnitude<1,"Shop box moved off the buy pad before confirmation")
      local result=invokeBounded(chatting,8,npcInfo,"ConfirmPurchase")
      assert(result,"Cashier did not confirm the purchase of "..id)
    end)
    pcall(function() invokeBounded(chatting,1.5,npcInfo,"EndChat") end)
    pcall(function() invokeBounded(chattingValue,1.5,0) end)
    for attempt=1,60 do
      local owned=purchasedBox(id,box,before)
      if owned then
        prepareBoughtForPlacement(owned,id)
        return owned
      end
      task.wait(.05)
    end
    if not purchaseOk then error(purchaseError) end
    error("Purchase of "..id.." was not confirmed; cash before: "..moneyBefore..", now: "..player.leaderstats.Money.Value)
  end
  buyMissing=function(id)
    status("Buying missing "..id.." box at the store...")
    local oldPosition=rootPart.CFrame
    local ok,result=pcall(buyOne,id)
    __HuxGhost:BeforeTeleport(rootPart); rootPart.CFrame=oldPosition
    if not ok then purchaseHalted=tostring(result);error(result) end
    print("Wire Atelier bought",id,"for",infoRoot[id].Price.Value)
    return result
  end
end
local boxIsParented=placeRoot:FindFirstChild("BoxIsParented")
local progress=placementStore.WireAtelierProgress
if not progress or progress.planJson~=planJson or (progress.hit-hit).Magnitude>.01 or (progress.horizontal-horizontal).Magnitude>.01 then
  progress={planJson=planJson,hit=hit,horizontal=horizontal,done={},failed={}}
  placementStore.WireAtelierProgress=progress
end
local tally={placed=0,pending=0,retried=0,failed=0,skipped=0}
local totalPlacements=TEAM_ROLE=="worker" and 0 or #jobs+#switches
local function report(action)
  status(action.." | placed "..tally.placed.."/"..totalPlacements.." pending "..tally.pending.." retried "..tally.retried.." failed "..tally.failed)
end
local function modelHasValue(model,class,name,wanted)
  local named=model:FindFirstChild(name)
  if named and named:IsA(class) and named.Value==wanted then return true end
  for _,child in ipairs(model:GetChildren()) do
    if child:IsA(class) and child.Value==wanted then return true end
  end
  return false
end
local function nearbyModels(position)
  local models,seen={},{}
  local ok,parts=pcall(function() return workspace:GetPartBoundsInRadius(position,.55) end)
  if ok then
    for _,part in ipairs(parts) do
      local model=part.Parent
      if model and model:IsA("Model") and not seen[model] then
        seen[model]=true;table.insert(models,model)
      end
    end
  else
    for _,instance in ipairs(workspace:GetDescendants()) do
      if instance:IsA("Model") then table.insert(models,instance) end
    end
  end
  return models
end
local function hasEndAt(model,name,position)
  local named=model:FindFirstChild(name)
  if named and named:IsA("BasePart") and (named.Position-position).Magnitude<=.18 then return true end
  for _,child in ipairs(model:GetChildren()) do
    if child:IsA("BasePart") and (child.Position-position).Magnitude<=.12 then return true end
  end
  return false
end
local function findPlacedWire(job)
  local first,last=job.points[1],job.points[#job.points]
  for _,model in ipairs(nearbyModels(first)) do
    local own=boxOwner(model)
    if own and own.Value==owner and modelHasValue(model,"StringValue","ItemName",job.id)
      and modelHasValue(model,"StringValue","Type","Wire")
      and hasEndAt(model,"End1",first) and hasEndAt(model,"End2",last) then
      return model
    end
  end
end
local function findPlacedLever(sw,position)
  for _,model in ipairs(nearbyModels(position)) do
    local own=boxOwner(model)
    if own and own.Value==owner and modelHasValue(model,"StringValue","ItemName","Lever0")
      and model.PrimaryPart and (model.PrimaryPart.Position-position).Magnitude<=.35 then
      return model
    end
  end
end
local function waitForModel(find,seconds)
  local deadline=os.clock()+seconds
  repeat
    local model=find()
    if model then return model end
    task.wait(.1)
  until os.clock()>=deadline
  return find()
end
local function takeBox(id)
  local list=boxes[id] or {}
  while #list>0 do
    local box=table.remove(list)
    local own=boxOwner(box)
    if box.Parent and own and own.Value==player then return box end
  end
  if purchaseHalted then error("Automatic checkout paused: "..purchaseHalted) end
  if not buyMissing then return nil,"No owned "..id.." box on the target plot" end
  local ok,err=pcall(buyMissing,id)
  if not ok then
    purchaseHalted=tostring(err)
    error("Automatic checkout paused after one failed purchase: "..purchaseHalted)
  end
  local bought=boxes[id] and table.remove(boxes[id])
  if bought and bought.Parent then return bought end
  return nil,"Purchase did not yield a usable "..id.." box"
end
local function placeVerified(key,id,find,send)
  if stopped or not statusGui.Parent then error("Stopped") end
  if find() then
    tally.placed=tally.placed+1;tally.skipped=tally.skipped+1
    progress.done[key]=true;progress.failed[key]=nil
    report("Already placed "..id)
    return true
  end
  local box,reason=takeBox(id)
  if not box then
    tally.failed=tally.failed+1;progress.failed[key]=reason
    report("Needs box: "..id);return false
  end
  local parent=box.Parent
  local requestable,requests=true,0
  local pendingReason
  local ok,_,why=CodexPlacing.run({
    timeout=15,interval=.12,
    cancelled=function()return stopped or not statusGui.Parent end,
    ready=function()return requestable end,
    observe=find,
    waitRate=function()
      local remaining=nextPlacementAt-os.clock()
      if remaining>0 then task.wait(remaining) end
      if find() then return true end
      if requests>0 then
        local checked,exists=false,false
        if boxIsParented then checked,exists=pcall(function()return boxIsParented:InvokeServer(box,parent)end) end
        requestable=checked and exists==true
        if requestable then
          pcall(function()if not box.Parent then box.Parent=parent end end)
        else
          pendingReason="Source consumed or pending; waiting for matching geometry"
        end
      end
      return true
    end,
    onAttempt=function(attempt)
      tally.pending=1
      if attempt>1 then tally.retried=tally.retried+1 end
      report("Sending "..id.." attempt "..attempt)
    end,
    send=function()
      requests=requests+1
      box.Parent=nil
      send(box)
      nextPlacementAt=os.clock()+MIN_PLACEMENT_INTERVAL
    end,
  })
  tally.pending=0
  if ok then
    tally.placed=tally.placed+1;progress.done[key]=true;progress.failed[key]=nil
    report("Confirmed "..id);return true
  end
  if requestable then pcall(function()if not box.Parent then box.Parent=parent end end) end
  tally.failed=tally.failed+1;progress.failed[key]=pendingReason or why
  report("Could not verify "..id)
  return false
end
if TEAM_ROLE=="worker" then
  status("Helper ready. Waiting for wire requests from the plot owner...")
  while not stopped and statusGui.Parent do
    local response=teamPost("next")
    if response.stopped then break end
    if response.job then
      local command=response.job
      local key,id=command.key,command.id
      totalPlacements=totalPlacements+1
      local ok,placed=pcall(function()
        local info=infoRoot:FindFirstChild(id)
        assert(info and info:FindFirstChild("OtherInfo"),"Missing wire item definition "..id)
        local points,total={},0
        for _,q in ipairs(command.points) do table.insert(points,Vector3.new(q[1],q[2],q[3])) end
        for section=2,#points do
          local length=(points[section]-points[section-1]).Magnitude
          assert(length>=.41-.0001,"Requested wire has a section below 0.41 studs")
          total=total+length
        end
        assert(total<=MAX_WIRE_LENGTH+.0001,"Requested wire exceeds the 60-stud cap")
        for _,point in ipairs(points) do
          local allowed,found=CanPlace:CanPlace(player,point,{Land=land,PermissionType=permissions})
          assert(allowed and found==owner,"Requested wire is not on the permitted leader plot")
        end
        local job={id=id,points=points,kind="delegated art"}
        return placeVerified(key,id,function() return findPlacedWire(job) end,function(itemBox)
          placedWire:FireServer(info,points,owner,itemBox,true)
        end)
      end)
      local reason=ok and (progress.failed[key] or "") or tostring(placed)
      teamPost("result",{key=key,placed=ok and placed==true,reason=reason})
      status((ok and placed and "Verified " or "Could not place ")..id.." for the plot owner")
      if purchaseHalted then error("Automatic checkout paused: "..purchaseHalted) end
    else
      task.wait(.35)
    end
  end
else
  local function delegated(id)
    if TEAM_ROLE~="leader" then return false end
    for _,wanted in ipairs(TEAM_FILTER) do if wanted=="*" or wanted==id then return true end end
    return false
  end
  for n,job in ipairs(jobs) do
    local key="wire:"..n..":"..job.id
    local info=infoRoot:FindFirstChild(job.id)
    if not info then
      tally.failed=tally.failed+1;progress.failed[key]="Missing item definition "..job.id
    elseif delegated(job.id) then
      if findPlacedWire(job) then
        tally.placed=tally.placed+1;tally.skipped=tally.skipped+1;progress.done[key]=true;progress.failed[key]=nil
        report("Already placed "..job.id)
      else
        local coordinates={}
        for _,point in ipairs(job.points) do table.insert(coordinates,{point.X,point.Y,point.Z}) end
        teamPost("enqueue",{job={key=key,id=job.id,points=coordinates}})
        local result=nil
        for attempt=1,1200 do
          result=teamPost("resultGet",{key=key}).result
          if result then break end
          if stopped or not statusGui.Parent then error("Stopped") end
          if attempt%20==0 then report("Waiting for helper: "..job.id) end
          task.wait(.25)
        end
        assert(result,"Helper did not answer wire "..n..". The request remains pending; resume only after checking both accounts.")
        if result.placed and waitForModel(function() return findPlacedWire(job) end,3) then
          tally.placed=tally.placed+1;progress.done[key]=true;progress.failed[key]=nil
          report("Helper placed "..job.id)
        else
          tally.failed=tally.failed+1;progress.failed[key]=result.reason~="" and result.reason or "Helper did not verify the placed wire"
          report("Helper could not place "..job.id)
          if string.find(progress.failed[key],"Automatic checkout paused",1,true) then error(progress.failed[key]) end
        end
      end
    else
      placeVerified(key,job.id,function() return findPlacedWire(job) end,function(itemBox)
        placedWire:FireServer(info,job.points,owner,itemBox,true)
      end)
    end
  end
  local leverInfo=infoRoot:FindFirstChild("Lever0")
  assert(leverInfo and leverInfo:FindFirstChild("Model"),"Lever0 item definition is missing")
  local template=leverInfo.Model
  local output=template:FindFirstChild("Output",true)
  assert(template.PrimaryPart and output,"Lever0 output geometry is missing")
  local outputOffset=output.Position-template.PrimaryPart.Position
  for n,sw in ipairs(switches) do
    local cf=CFrame.new(sw.position-outputOffset)*template.PrimaryPart.CFrame.Rotation
    placeVerified("lever:"..n,"Lever0",function() return findPlacedLever(sw,cf.Position) end,function(itemBox)
      placedStructure:FireServer("Lever0",cf,owner,nil,itemBox,false,true)
    end)
  end
  if TEAM_ROLE=="leader" then teamPost("stop") end
end
print("Wire Atelier verified",tally.placed,"placements; skipped",tally.skipped,"already present; retried",tally.retried,"failed",tally.failed)
status("Verified "..tally.placed.."/"..totalPlacements.." | pending "..tally.pending.." retried "..tally.retried.." failed "..tally.failed)
if tally.failed==0 then placementStore.WireAtelierPlacement=nil end
end
