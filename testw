local function addPath(id,raw,kind,on)
  local points={}
  for _,p in ipairs(raw) do
    if #points==0 or (p-points[#points]).Magnitude>.0001 then
      while #points>=2 do
        local a,b=points[#points-1],points[#points]
        local u,v=(b-a).Unit,(p-b).Unit
        if u:Cross(v).Magnitude<.0001 and u:Dot(v)>.9999 then table.remove(points) else break end
      end
      table.insert(points,p)
    end
  end
  assert(#points>=2,"Wire needs at least two distinct points")
  local total=0
  for i=2,#points do
    local section=(points[i]-points[i-1]).Magnitude
    assert(section>=.41-0.0001,"A wire section is below 0.41 studs: "..kind)
    total=total+section
  end
  local maxLength=MAX_WIRE_LENGTH
  assert(total<=maxLength+0.0001,"A wire exceeds the 60-stud total length cap: "..kind)
  table.insert(jobs,{id=id,points=points,kind=kind,on=on})
  need[id]=(need[id] or 0)+1
end
local function addWire(id,a,b,kind,on) addPath(id,{a,b},kind,on) end
local function addChopped(id,a,b,kind)
  local length=(b-a).Magnitude
  if length<.0001 then return end
  local maxLength=MAX_WIRE_LENGTH
  local count=math.ceil(length/(maxLength))
  assert(length/count>=.41-0.0001,"A rear section is below 0.41 studs")
  for n=1,count do addWire(id,a:Lerp(b,(n-1)/count),a:Lerp(b,n/count),kind) end
end
