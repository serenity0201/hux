local function whiteEnough(color)
  local brightest=math.max(color.R,color.G,color.B)
  local darkest=math.min(color.R,color.G,color.B)
  return darkest>=.65 and brightest-darkest<=.16
end
local function colorDistance(a,b)
  local r,g,blue=a.R-b.R,a.G-b.G,a.B-b.B
