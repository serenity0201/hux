local function collectRenamedLand()
  local bounds={}
  local function inspect(property)
    if not (property:IsA("Model") or property:IsA("Folder")) then return end
    local plotOwner=nil
    local tiles={}
    local placedItem=false
    for _,child in ipairs(property:GetChildren()) do
      if child:IsA("ObjectValue") and child.Value and child.Value:IsA("Player") then
        plotOwner=child.Value
      elseif child:IsA("BasePart") and child.Size.X>=4.9 and child.Size.Z>=4.9 and child.Size.Y<=5 then
        table.insert(tiles,child)
      elseif child:IsA("StringValue") and infoRoot:FindFirstChild(child.Value) then
        placedItem=true
      end
    end
    if not plotOwner or #tiles==0 or placedItem then return end
    local allowed=plotOwner==player
    if not allowed then
      local ok,result=pcall(function()
        return permissionModule:IsInteractionTypePermitted(player,plotOwner,permissions)
      end)
      allowed=ok and result==true
    end
    if not allowed then return end
    for _,tile in ipairs(tiles) do
      local half=tile.Size/2
      table.insert(bounds,{
        minBounds=Vector3.new(tile.Position.X-half.X,tile.Position.Y,tile.Position.Z-half.Z),
        maxBounds=Vector3.new(tile.Position.X+half.X,tile.Position.Y+100,tile.Position.Z+half.Z),
        owner=plotOwner
      })
    end
  end
  for _,container in ipairs(workspace:GetChildren()) do
    inspect(container)
    for _,candidate in ipairs(container:GetChildren()) do inspect(candidate) end
  end
  return bounds
end
